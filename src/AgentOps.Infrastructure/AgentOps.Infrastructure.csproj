<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- Provides DI/configuration abstractions without extra NuGet packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Brings Microsoft.IdentityModel (JsonWebTokenHandler) used to issue tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentOps.Application\AgentOps.Application.csproj" />
  </ItemGroup>
</Project>
