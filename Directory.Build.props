<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Product>AgentOps AI .NET</Product>
    <Company>AgentOps AI .NET</Company>
    <Description>Enterprise-Grade AI Agent Orchestration Platform Built with ASP.NET Core</Description>
    <RepositoryUrl>https://github.com/ajanta-luhana/AgentOps-AI-DotNet</RepositoryUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
